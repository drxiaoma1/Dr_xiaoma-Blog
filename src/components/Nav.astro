---
import { url, base } from '~/utils/url';
const links = [
  { href: url('/'), label: '主页', kicker: 'I' },
  { href: url('/blog'), label: '博客', kicker: 'II' },
  { href: url('/tags'), label: '标签', kicker: 'III' },
];
const path = Astro.url.pathname;
const normalized = path.replace(/\/$/, '') || '/';
const homeHref = base.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  if (h === homeHref) return normalized === homeHref;
  return normalized === h || normalized.startsWith(h + '/');
};
---
<header class="sticky top-0 z-40 border-b border-paper-edge bg-paper/80 backdrop-blur supports-[backdrop-filter]:bg-paper/60">
  <nav class="container-wide flex items-center justify-between h-16">
    <a href={url('/')} class="no-underline flex items-baseline gap-2 group">
      <span class="font-display italic text-2xl leading-none tracking-tightest text-ink" style="font-variation-settings: 'opsz' 48, 'SOFT' 30;">Dr_xiaoma's Blog</span>
      <span class="eyebrow text-ink-mute group-hover:text-accent transition-colors hidden sm:inline">— est. MMXXVI</span>
    </a>
    <ul class="flex items-center gap-1">
      {links.map(l => (
        <li>
          <a
            href={l.href}
            class={`flex items-baseline gap-1.5 px-3 py-1.5 text-sm no-underline border-b transition-all ${isActive(l.href)
              ? 'text-ink border-accent'
              : 'text-ink-mute border-transparent hover:text-ink hover:border-paper-edge'}`}
          >
            <span class="num text-[10px] opacity-70">{l.kicker}</span>
            <span>{l.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
