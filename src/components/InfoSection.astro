---
interface Props { title: string; index: string; empty?: string }
const { title, index, empty = '暂未填写。' } = Astro.props;
---
<section class="card group transition-transform duration-300 hover:scale-105">
  <div class="flex items-baseline justify-between gap-4 mb-5">
    <div class="flex items-baseline gap-3">
      <span class="num text-lg leading-none">{index}</span>
      <h2 class="font-display text-2xl tracking-tightest" style="font-variation-settings:'opsz' 48,'SOFT' 30">{title}</h2>
    </div>
    <span class="rule flex-1 max-w-[120px] translate-y-[-4px] opacity-60 group-hover:opacity-100 transition-opacity"></span>
  </div>
  <div class="text-ink-soft text-sm leading-relaxed">
    <slot>
      <p class="text-ink-mute italic">{empty}</p>
    </slot>
  </div>
</section>
