---
const year = new Date().getFullYear();
const roman = (n: number) => {
  const map: [number, string][] = [[1000,'M'],[900,'CM'],[500,'D'],[400,'CD'],[100,'C'],[90,'XC'],[50,'L'],[40,'XL'],[10,'X'],[9,'IX'],[5,'V'],[4,'IV'],[1,'I']];
  let s = '', x = n; for (const [v, r] of map) while (x >= v) { s += r; x -= v; } return s;
};
---
<footer class="mt-24 border-t border-paper-edge">
  <div class="container-wide py-10 flex flex-col md:flex-row items-start md:items-end justify-between gap-6">
    <div>
      <p class="eyebrow">Colophon</p>
      <p class="mt-3 font-display text-2xl italic text-ink tracking-tightest" style="font-variation-settings:'opsz' 72,'SOFT' 30">
        Thanks for reading. — Dr_xiaoma
      </p>
      <p class="mt-1 text-sm text-ink-mute">
        Set in Fraunces &amp; Public Sans. Powered by Astro.
      </p>
    </div>
    <div class="text-right">
      <p class="num text-xs text-ink-mute">{roman(year)}</p>
      <p class="eyebrow mt-1">© {year} · Dr_xiaoma</p>
    </div>
  </div>
</footer>
