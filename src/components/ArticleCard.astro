---
interface Props {
  href: string; title: string; date: Date; summary: string; tags: string[]; index: number;
}
const { href, title, date, summary, tags, index } = Astro.props;
const dateStr = date.toISOString().slice(0, 10);
const num = String(index).padStart(2, '0');
---
<a href={href} class="block group no-underline border-t border-paper-edge first:border-t-0 py-7 hover:bg-paper-card/40 transition-colors -mx-4 px-4">
  <div class="grid grid-cols-12 gap-4 items-baseline">
    <span class="num text-sm col-span-2 md:col-span-1">№ {num}</span>
    <div class="col-span-10 md:col-span-9">
      <h3 class="font-display text-2xl md:text-3xl tracking-tightest leading-tight text-ink group-hover:text-accent transition-colors"
          style="font-variation-settings:'opsz' 48,'SOFT' 30">
        {title}
      </h3>
      <p class="mt-2 text-ink-soft text-sm leading-relaxed max-w-xl">{summary}</p>
      {tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2">
          {tags.map(t => <li class="pill">{t}</li>)}
        </ul>
      )}
    </div>
    <div class="hidden md:block md:col-span-2 text-right">
      <time class="num text-xs">{dateStr}</time>
      <div class="text-ink-mute text-xs mt-1 group-hover:text-accent transition-colors">阅读 →</div>
    </div>
  </div>
</a>
